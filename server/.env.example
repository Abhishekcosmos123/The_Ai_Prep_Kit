PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/the_ai_prep_kit
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# OpenAI-compatible LLM (OpenAI, Groq, Together, etc.)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
# mock | openai (empty LLM_API_KEY also forces mock)
LLM_PROVIDER=mock

# Logging: debug | info | warn | error
LOG_LEVEL=info

# Pipeline tuning
MAX_COVERAGE_PASSES=3
MAX_JD_CHARS=50000
MAX_CRAWL_PAGES=8
FETCH_TIMEOUT_MS=10000
LLM_MAX_RETRIES=4
LLM_MIN_INTERVAL_MS=800

# Required for evaluate fixtures like http://localhost:8099/acme/
# Keep false on a public production deployment unless you intentionally need it.
ALLOW_LOCAL_URLS=false
